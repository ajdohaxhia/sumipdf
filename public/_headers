# Cloudflare Pages headers for Sumi PDF
# Required for SharedArrayBuffer (LibreOffice WASM) and correct WASM MIME types.
# This is an MPA: do not add SPA catch-all redirects.

/*
  Cross-Origin-Embedder-Policy: require-corp
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: cross-origin
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(self), microphone=(), geolocation=()

/index.html
  Cache-Control: no-cache

/*.html
  Cache-Control: no-cache

/sw.js
  Cache-Control: no-cache

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/*.wasm
  Content-Type: application/wasm
  Cache-Control: public, max-age=31536000, immutable

/libreoffice-wasm/assets-manifest.json
  Cache-Control: no-cache

/libreoffice-wasm/*.part-:index
  Content-Type: application/octet-stream
  Cache-Control: public, max-age=31536000, immutable
