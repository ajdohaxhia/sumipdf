# Sumi PDF Environment Variables
# Copy this file to .env.production and configure as needed.

# Public site URL (required for production sitemap/canonicals on Cloudflare Pages)
VITE_SITE_URL=
SITE_URL=

# Cloudflare Pages tip: also set NODE_VERSION=20.19.0 in the dashboard.
# LibreOffice assets are sharded automatically during the production build.

ENABLE_GITHUB_STARS=
VITE_REPO_URL=https://github.com/ajdohaxhia/sumipdf
VITE_UPSTREAM_URL=https://github.com/alam00000/bentopdf
VITE_AUTHOR_URL=https://adelajdo.com
VITE_COMMIT_SHA=
VITE_BUILD_DATE=
VITE_NOINDEX=

# CORS Proxy for digital signature certificate chain fetching (optional, off by default)
# Deploy cloudflare/wrangler.toml, then set the worker URL here and rebuild Pages.
VITE_CORS_PROXY_URL=
VITE_CORS_PROXY_SECRET=

# WASM Module URLs
VITE_WASM_PYMUPDF_URL=https://cdn.jsdelivr.net/npm/@bentopdf/pymupdf-wasm@0.11.16/
VITE_WASM_GS_URL=https://cdn.jsdelivr.net/npm/@bentopdf/gs-wasm@0.1.1/assets/
VITE_WASM_CPDF_URL=https://cdn.jsdelivr.net/npm/coherentpdf@2.5.5/dist/

VITE_TESSERACT_WORKER_URL=
VITE_TESSERACT_CORE_URL=
VITE_TESSERACT_LANG_URL=
VITE_TESSERACT_AVAILABLE_LANGUAGES=
VITE_OCR_FONT_BASE_URL=

VITE_DEFAULT_LANGUAGE=

# Custom branding (build-time). Defaults to Sumi PDF when empty.
VITE_BRAND_NAME=Sumi PDF
VITE_BRAND_LOGO=images/logo-mark.svg
VITE_FOOTER_TEXT=
